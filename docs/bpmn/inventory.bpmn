<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Inventory" targetNamespace="urn:shaunti:to-be"><bpmn:process id="Inventory" name="To-Be: Procurement and Water Stock Preparation" isExecutable="false"><bpmn:laneSet id="Lanes_Inventory"><bpmn:lane id="Inventory_Lane0" name="Admin"><bpmn:flowNodeRef>Inventory_start</bpmn:flowNodeRef><bpmn:flowNodeRef>Inventory_review</bpmn:flowNodeRef><bpmn:flowNodeRef>Inventory_po</bpmn:flowNodeRef><bpmn:flowNodeRef>Inventory_receive</bpmn:flowNodeRef><bpmn:flowNodeRef>Inventory_correct</bpmn:flowNodeRef><bpmn:flowNodeRef>Inventory_wait</bpmn:flowNodeRef><bpmn:flowNodeRef>Inventory_water</bpmn:flowNodeRef><bpmn:flowNodeRef>Inventory_fill</bpmn:flowNodeRef><bpmn:flowNodeRef>Inventory_usage</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Inventory_Lane1" name="Management System"><bpmn:flowNodeRef>Inventory_expense</bpmn:flowNodeRef><bpmn:flowNodeRef>Inventory_check</bpmn:flowNodeRef><bpmn:flowNodeRef>Inventory_valid</bpmn:flowNodeRef><bpmn:flowNodeRef>Inventory_update</bpmn:flowNodeRef><bpmn:flowNodeRef>Inventory_complete</bpmn:flowNodeRef><bpmn:flowNodeRef>Inventory_production</bpmn:flowNodeRef><bpmn:flowNodeRef>Inventory_ready</bpmn:flowNodeRef><bpmn:flowNodeRef>Inventory_end</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="Inventory_start" name="Stock replenishment needed"><bpmn:outgoing>Inventory_F0</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="Inventory_review" name="Review stock, reorder list and supplier"><bpmn:incoming>Inventory_F0</bpmn:incoming><bpmn:outgoing>Inventory_F1</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Inventory_po" name="Create purchase order and set ordered status"><bpmn:incoming>Inventory_F1</bpmn:incoming><bpmn:outgoing>Inventory_F2</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="Inventory_expense" name="Synchronize linked purchase-order expense"><bpmn:incoming>Inventory_F2</bpmn:incoming><bpmn:outgoing>Inventory_F3</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="Inventory_receive" name="Receive supplier delivery; enter actual quantities"><bpmn:incoming>Inventory_F3</bpmn:incoming><bpmn:outgoing>Inventory_F4</bpmn:outgoing><bpmn:incoming>Inventory_F7</bpmn:incoming><bpmn:incoming>Inventory_F11</bpmn:incoming></bpmn:userTask><bpmn:serviceTask id="Inventory_check" name="Validate remaining quantities and receipt reference"><bpmn:incoming>Inventory_F4</bpmn:incoming><bpmn:outgoing>Inventory_F5</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="Inventory_valid" name="Valid receipt?"><bpmn:incoming>Inventory_F5</bpmn:incoming><bpmn:outgoing>Inventory_F6</bpmn:outgoing><bpmn:outgoing>Inventory_F8</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="Inventory_correct" name="Correct receipt details"><bpmn:incoming>Inventory_F6</bpmn:incoming><bpmn:outgoing>Inventory_F7</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="Inventory_update" name="Increase inventory, log stock movements and recalculate PO status"><bpmn:incoming>Inventory_F8</bpmn:incoming><bpmn:outgoing>Inventory_F9</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="Inventory_complete" name="Fully received?"><bpmn:incoming>Inventory_F9</bpmn:incoming><bpmn:outgoing>Inventory_F10</bpmn:outgoing><bpmn:outgoing>Inventory_F12</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="Inventory_wait" name="Await remaining supplier delivery"><bpmn:incoming>Inventory_F10</bpmn:incoming><bpmn:outgoing>Inventory_F11</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="Inventory_water" name="Prepare water stock?"><bpmn:incoming>Inventory_F12</bpmn:incoming><bpmn:outgoing>Inventory_F13</bpmn:outgoing><bpmn:outgoing>Inventory_F14</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="Inventory_fill" name="Fill available empty gallons and select water product"><bpmn:incoming>Inventory_F13</bpmn:incoming><bpmn:outgoing>Inventory_F15</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="Inventory_production" name="Update filled gallons and product stock; save production log"><bpmn:incoming>Inventory_F15</bpmn:incoming><bpmn:outgoing>Inventory_F16</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="Inventory_ready" name=""><bpmn:incoming>Inventory_F14</bpmn:incoming><bpmn:incoming>Inventory_F16</bpmn:incoming><bpmn:outgoing>Inventory_F17</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="Inventory_usage" name="Record supplies usage and maintenance when performed"><bpmn:incoming>Inventory_F17</bpmn:incoming><bpmn:outgoing>Inventory_F18</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="Inventory_end" name="Stock available for operations"><bpmn:incoming>Inventory_F18</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Inventory_F0" sourceRef="Inventory_start" targetRef="Inventory_review"/><bpmn:sequenceFlow id="Inventory_F1" sourceRef="Inventory_review" targetRef="Inventory_po"/><bpmn:sequenceFlow id="Inventory_F2" sourceRef="Inventory_po" targetRef="Inventory_expense"/><bpmn:sequenceFlow id="Inventory_F3" sourceRef="Inventory_expense" targetRef="Inventory_receive"/><bpmn:sequenceFlow id="Inventory_F4" sourceRef="Inventory_receive" targetRef="Inventory_check"/><bpmn:sequenceFlow id="Inventory_F5" sourceRef="Inventory_check" targetRef="Inventory_valid"/><bpmn:sequenceFlow id="Inventory_F6" sourceRef="Inventory_valid" targetRef="Inventory_correct" name="No"/><bpmn:sequenceFlow id="Inventory_F7" sourceRef="Inventory_correct" targetRef="Inventory_receive"/><bpmn:sequenceFlow id="Inventory_F8" sourceRef="Inventory_valid" targetRef="Inventory_update" name="Yes"/><bpmn:sequenceFlow id="Inventory_F9" sourceRef="Inventory_update" targetRef="Inventory_complete"/><bpmn:sequenceFlow id="Inventory_F10" sourceRef="Inventory_complete" targetRef="Inventory_wait" name="No"/><bpmn:sequenceFlow id="Inventory_F11" sourceRef="Inventory_wait" targetRef="Inventory_receive"/><bpmn:sequenceFlow id="Inventory_F12" sourceRef="Inventory_complete" targetRef="Inventory_water" name="Yes"/><bpmn:sequenceFlow id="Inventory_F13" sourceRef="Inventory_water" targetRef="Inventory_fill" name="Yes"/><bpmn:sequenceFlow id="Inventory_F14" sourceRef="Inventory_water" targetRef="Inventory_ready" name="No"/><bpmn:sequenceFlow id="Inventory_F15" sourceRef="Inventory_fill" targetRef="Inventory_production"/><bpmn:sequenceFlow id="Inventory_F16" sourceRef="Inventory_production" targetRef="Inventory_ready"/><bpmn:sequenceFlow id="Inventory_F17" sourceRef="Inventory_ready" targetRef="Inventory_usage"/><bpmn:sequenceFlow id="Inventory_F18" sourceRef="Inventory_usage" targetRef="Inventory_end"/></bpmn:process><bpmndi:BPMNDiagram id="Diagram_Inventory"><bpmndi:BPMNPlane id="Plane_Inventory" bpmnElement="Inventory"><bpmndi:BPMNShape id="Inventory_Lane0_di" bpmnElement="Inventory_Lane0" isHorizontal="false"><dc:Bounds x="70" y="60" width="320" height="2050"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Inventory_Lane1_di" bpmnElement="Inventory_Lane1" isHorizontal="false"><dc:Bounds x="390" y="60" width="320" height="2050"/></bpmndi:BPMNShape><bpmndi:BPMNEdge id="Inventory_F0_di" bpmnElement="Inventory_F0"><di:waypoint x="225" y="138"/><di:waypoint x="225" y="176.5"/><di:waypoint x="225" y="176.5"/><di:waypoint x="225" y="215"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Inventory_F1_di" bpmnElement="Inventory_F1"><di:waypoint x="225" y="287"/><di:waypoint x="225" y="308.5"/><di:waypoint x="225" y="308.5"/><di:waypoint x="225" y="330"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Inventory_F2_di" bpmnElement="Inventory_F2"><di:waypoint x="225" y="402"/><di:waypoint x="225" y="423.5"/><di:waypoint x="545" y="423.5"/><di:waypoint x="545" y="445"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Inventory_F3_di" bpmnElement="Inventory_F3"><di:waypoint x="545" y="517"/><di:waypoint x="545" y="538.5"/><di:waypoint x="225" y="538.5"/><di:waypoint x="225" y="560"/