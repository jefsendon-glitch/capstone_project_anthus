<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Credit" targetNamespace="urn:shaunti:to-be"><bpmn:process id="Credit" name="To-Be: Credit Monitoring and Collection" isExecutable="false"><bpmn:laneSet id="Lanes_Credit"><bpmn:lane id="Credit_Lane0" name="Staff / Admin"><bpmn:flowNodeRef>Credit_receive</bpmn:flowNodeRef><bpmn:flowNodeRef>Credit_correct</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Credit_Lane1" name="Management System"><bpmn:flowNodeRef>Credit_start</bpmn:flowNodeRef><bpmn:flowNodeRef>Credit_scan</bpmn:flowNodeRef><bpmn:flowNodeRef>Credit_overdue</bpmn:flowNodeRef><bpmn:flowNodeRef>Credit_none</bpmn:flowNodeRef><bpmn:flowNodeRef>Credit_suspend</bpmn:flowNodeRef><bpmn:flowNodeRef>Credit_validate</bpmn:flowNodeRef><bpmn:flowNodeRef>Credit_valid</bpmn:flowNodeRef><bpmn:flowNodeRef>Credit_allocate</bpmn:flowNodeRef><bpmn:flowNodeRef>Credit_paid</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Credit_Lane2" name="Admin"><bpmn:flowNodeRef>Credit_review</bpmn:flowNodeRef><bpmn:flowNodeRef>Credit_end</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="Credit_start" name="Hourly credit monitoring"><bpmn:outgoing>Credit_F0</bpmn:outgoing><bpmn:timerEventDefinition/></bpmn:startEvent><bpmn:serviceTask id="Credit_scan" name="Find unpaid credit reaching 14-day term"><bpmn:incoming>Credit_F0</bpmn:incoming><bpmn:outgoing>Credit_F1</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="Credit_overdue" name="Overdue found?"><bpmn:incoming>Credit_F1</bpmn:incoming><bpmn:outgoing>Credit_F2</bpmn:outgoing><bpmn:outgoing>Credit_F3</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:endEvent id="Credit_none" name="Monitoring complete"><bpmn:incoming>Credit_F2</bpmn:incoming></bpmn:endEvent><bpmn:serviceTask id="Credit_suspend" name="Suspend credit; notify customer, admin and staff"><bpmn:incoming>Credit_F3</bpmn:incoming><bpmn:outgoing>Credit_F4</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="Credit_receive" name="Receive customer payment and enter collection"><bpmn:incoming>Credit_F4</bpmn:incoming><bpmn:outgoing>Credit_F5</bpmn:outgoing><bpmn:incoming>Credit_F8</bpmn:incoming><bpmn:incoming>Credit_F11</bpmn:incoming></bpmn:userTask><bpmn:serviceTask id="Credit_validate" name="Validate payment against outstanding balance"><bpmn:incoming>Credit_F5</bpmn:incoming><bpmn:outgoing>Credit_F6</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="Credit_valid" name="Valid amount?"><bpmn:incoming>Credit_F6</bpmn:incoming><bpmn:outgoing>Credit_F7</bpmn:outgoing><bpmn:outgoing>Credit_F9</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="Credit_correct" name="Correct payment amount"><bpmn:incoming>Credit_F7</bpmn:incoming><bpmn:outgoing>Credit_F8</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="Credit_allocate" name="Save payment, reduce balance and allocate to oldest due credits"><bpmn:incoming>Credit_F9</bpmn:incoming><bpmn:outgoing>Credit_F10</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="Credit_paid" name="Balance settled?"><bpmn:incoming>Credit_F10</bpmn:incoming><bpmn:outgoing>Credit_F11</bpmn:outgoing><bpmn:outgoing>Credit_F12</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="Credit_review" name="Review customer credit status; decide whether to restore eligibility"><bpmn:incoming>Credit_F12</bpmn:incoming><bpmn:outgoing>Credit_F13</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="Credit_end" name="Collection recorded and account reviewed"><bpmn:incoming>Credit_F13</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Credit_F0" sourceRef="Credit_start" targetRef="Credit_scan"/><bpmn:sequenceFlow id="Credit_F1" sourceRef="Credit_scan" targetRef="Credit_overdue"/><bpmn:sequenceFlow id="Credit_F2" sourceRef="Credit_overdue" targetRef="Credit_none" name="No"/><bpmn:sequenceFlow id="Credit_F3" sourceRef="Credit_overdue" targetRef="Credit_suspend" name="Yes"/><bpmn:sequenceFlow id="Credit_F4" sourceRef="Credit_suspend" targetRef="Credit_receive"/><bpmn:sequenceFlow id="Credit_F5" sourceRef="Credit_receive" targetRef="Credit_validate"/><bpmn:sequenceFlow id="Credit_F6" sourceRef="Credit_validate" targetRef="Credit_valid"/><bpmn:sequenceFlow id="Credit_F7" sourceRef="Credit_valid" targetRef="Credit_correct" name="No"/><bpmn:sequenceFlow id="Credit_F8" sourceRef="Credit_correct" targetRef="Credit_receive"/><bpmn:sequenceFlow id="Credit_F9" sourceRef="Credit_valid" targetRef="Credit_allocate" name="Yes"/><bpmn:sequenceFlow id="Credit_F10" sourceRef="Credit_allocate" targetRef="Credit_paid"/><bpmn:sequenceFlow id="Credit_F11" sourceRef="Credit_paid" targetRef="Credit_receive" name="No: later payment"/><bpmn:sequenceFlow id="Credit_F12" sourceRef="Credit_paid" targetRef="Credit_review" name="Yes"/><bpmn:sequenceFlow id="Credit_F13" sourceRef="Credit_review" targetRef="Credit_end"/></bpmn:process><bpmndi:BPMNDiagram id="Diagram_Credit"><bpmndi:BPMNPlane id="Plane_Credit" bpmnElement="Credit"><bpmndi:BPMNShape id="Credit_Lane0_di" bpmnElement="Credit_Lane0" isHorizontal="false"><dc:Bounds x="70" y="60" width="320" height="1590"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Credit_Lane1_di" bpmnElement="Credit_Lane1" isHorizontal="false"><dc:Bounds x="390" y="60" width="320" height="1590"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Credit_Lane2_di" bpmnElement="Credit_Lane2" isHorizontal="false"><dc:Bounds x="710" y="60" width="320" height="1590"/></bpmndi:BPMNShape><bpmndi:BPMNEdge id="Credit_F0_di" bpmnElement="Credit_F0"><di:waypoint x="545" y="138"/><di:waypoint x="545" y="176.5"/><di:waypoint x="545" y="176.5"/><di:waypoint x="545" y="215"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Credit_F1_di" bpmnElement="Credit_F1"><di:waypoint x="545" y="287"/><di:waypoint x="545" y="308.5"/><di:waypoint x="545" y="308.5"/><di:waypoint x="545" y="330"/></bpmndi:BPMNEdge><bpmndi:BPM