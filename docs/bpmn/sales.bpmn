<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Sales" targetNamespace="urn:shaunti:to-be"><bpmn:process id="Sales" name="To-Be: Sales and Delivery Fulfillment" isExecutable="false"><bpmn:laneSet id="Lanes_Sales"><bpmn:lane id="Sales_Lane0" name="Staff / Admin"><bpmn:flowNodeRef>Sales_start</bpmn:flowNodeRef><bpmn:flowNodeRef>Sales_entry</bpmn:flowNodeRef><bpmn:flowNodeRef>Sales_correct</bpmn:flowNodeRef><bpmn:flowNodeRef>Sales_channel</bpmn:flowNodeRef><bpmn:flowNodeRef>Sales_confirm</bpmn:flowNodeRef><bpmn:flowNodeRef>Sales_dispatch</bpmn:flowNodeRef><bpmn:flowNodeRef>Sales_deliver</bpmn:flowNodeRef><bpmn:flowNodeRef>Sales_cash</bpmn:flowNodeRef><bpmn:flowNodeRef>Sales_collect</bpmn:flowNodeRef><bpmn:flowNodeRef>Sales_receipt</bpmn:flowNodeRef><bpmn:flowNodeRef>Sales_end</bpmn:flowNodeRef><bpmn:flowNodeRef>Sales_cancel</bpmn:flowNodeRef><bpmn:flowNodeRef>Sales_cancelled</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Sales_Lane1" name="Management System"><bpmn:flowNodeRef>Sales_validate</bpmn:flowNodeRef><bpmn:flowNodeRef>Sales_valid</bpmn:flowNodeRef><bpmn:flowNodeRef>Sales_credit</bpmn:flowNodeRef><bpmn:flowNodeRef>Sales_merge</bpmn:flowNodeRef><bpmn:flowNodeRef>Sales_post</bpmn:flowNodeRef><bpmn:flowNodeRef>Sales_balance</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="Sales_start" name="Customer requests products"><bpmn:outgoing>Sales_F0</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="Sales_entry" name="Enter POS sale or receive portal order"><bpmn:incoming>Sales_F0</bpmn:incoming><bpmn:outgoing>Sales_F1</bpmn:outgoing><bpmn:incoming>Sales_F4</bpmn:incoming></bpmn:userTask><bpmn:serviceTask id="Sales_validate" name="Validate products, container stock and credit eligibility"><bpmn:incoming>Sales_F1</bpmn:incoming><bpmn:outgoing>Sales_F2</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="Sales_valid" name="Valid?"><bpmn:incoming>Sales_F2</bpmn:incoming><bpmn:outgoing>Sales_F3</bpmn:outgoing><bpmn:outgoing>Sales_F5</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="Sales_correct" name="Correct order, replenish stock or choose cash"><bpmn:incoming>Sales_F3</bpmn:incoming><bpmn:outgoing>Sales_F4</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="Sales_channel" name="Delivery?"><bpmn:incoming>Sales_F5</bpmn:incoming><bpmn:outgoing>Sales_F6</bpmn:outgoing><bpmn:outgoing>Sales_F7</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="Sales_confirm" name="Confirm pending delivery order"><bpmn:incoming>Sales_F6</bpmn:incoming><bpmn:outgoing>Sales_F8</bpmn:outgoing><bpmn:outgoing>Sales_F19</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Sales_dispatch" name="Prepare order; mark out for delivery"><bpmn:incoming>Sales_F8</bpmn:incoming><bpmn:outgoing>Sales_F9</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Sales_deliver" name="Deliver; recheck stock and credit before completion"><bpmn:incoming>Sales_F9</bpmn:incoming><bpmn:outgoing>Sales_F10</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="Sales_cash" name="Cash?"><bpmn:incoming>Sales_F7</bpmn:incoming><bpmn:incoming>Sales_F10</bpmn:incoming><bpmn:outgoing>Sales_F11</bpmn:outgoing><bpmn:outgoing>Sales_F12</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="Sales_collect" name="Receive cash; POS validates tender and change"><bpmn:incoming>Sales_F11</bpmn:incoming><bpmn:outgoing>Sales_F13</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="Sales_credit" name="Set outstanding credit and 14-day due date"><bpmn:incoming>Sales_F12</bpmn:incoming><bpmn:outgoing>Sales_F14</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="Sales_merge" name=""><bpmn:incoming>Sales_F13</bpmn:incoming><bpmn:incoming>Sales_F14</bpmn:incoming><bpmn:outgoing>Sales_F15</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="Sales_post" name="Save sale, deduct container-specific product stock and log movement"><bpmn:incoming>Sales_F15</bpmn:incoming><bpmn:outgoing>Sales_F16</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="Sales_balance" name="Update credit balance if loan; mark delivery delivered if applicable"><bpmn:incoming>Sales_F16</bpmn:incoming><bpmn:outgoing>Sales_F17</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="Sales_receipt" name="View or issue receipt; record container handover separately if needed"><bpmn:incoming>Sales_F17</bpmn:incoming><bpmn:outgoing>Sales_F18</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="Sales_end" name="Sale completed"><bpmn:incoming>Sales_F18</bpmn:incoming></bpmn:endEvent><bpmn:userTask id="Sales_cancel" name="Cancel pending or confirmed delivery if needed"><bpmn:incoming>Sales_F19</bpmn:incoming><bpmn:outgoing>Sales_F20</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="Sales_cancelled" name="Delivery cancelled"><bpmn:incoming>Sales_F20</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Sales_F0" sourceRef="Sales_start" targetRef="Sales_entry"/><bpmn:sequenceFlow id="Sales_F1" sourceRef="Sales_entry" targetRef="Sales_validate"/><bpmn:sequenceFlow id="Sales_F2" sourceRef="Sales_validate" targetRef="Sales_valid"/><bpmn:sequenceFlow id="Sales_F3" sourceRef="Sales_valid" targetRef="Sales_correct" name="No"/><bpmn:sequenceFlow id="Sales_F4" sourceRef="Sales_correct" targetRef="Sales_entry"/><bpmn:sequenceFlow id="Sales_F5" sourceRef="Sales_valid" targetRef="Sales_channel" name="Yes"/><bpmn:sequenceFlow id="Sales_F6" sourceRef="Sales_channel" targetRef="Sales_confirm" name="Yes"/><bpmn:sequenceFlow id="Sales_F7" sourceRef="Sales_channel" targetRef="Sales_cash" name="No: walk-in"/><bpmn:sequenceFlow id="Sales_F8" sourceRef="Sales_confirm" targetRef="Sales_dispatch"/><bpmn:sequenceFlow id="Sales_F9" sourceRef="Sales_dispatch" targetRef="Sales_deliver"/><bpmn:sequenceFlow id="Sales_F10" sourceRef="Sales_deliver" targetRef="Sales_cash"/><bpmn:sequenceFlow id="Sales_F11" sourceRef="Sales_cash" targetRef="Sales_collect" name="Yes"/><bpmn:sequenceFlow id="Sales_F12" sourceRef="Sales_cash" targetRef="Sales_credit" name="No: eligible loan"/><bpmn:sequenceFlow id="Sales_F13" sourceRef="Sales_collect" targetRef="Sales_merge"/><bpmn:sequenceFlow id="Sales_F14" sourceRef="Sales_credit" targetRef="Sales_merge"/><bpmn:sequenceFlow id="Sales_F15" sourceRef="Sales_merge" targetRef="Sales_post"/><bpmn:sequenceFlow id="Sales_F16" sourceRef="Sales_post" targetRef="Sales_balance"/><bpmn:sequenceFlow id="Sales_F17" sourceRef="Sales_balance" targetRef="Sales_receipt"/><bpmn:sequenceFlow id="Sales_F18" sourceRef="Sales_receipt" targetRef="Sales_end"/><bpmn:sequenceFlow id="Sales_F19" sourceRef="Sales_confirm" targetRef="Sales_cancel" name="Cancel instead"/><bpmn:sequenceFlow id="Sales_F20" sourceRef="Sales_cancel" targetRef="Sales_cancelled"/></bpmn:process><bpmndi:BPMNDiagram id="Diagram_Sales"><bpmndi:BPMNPlane id="Plane_Sales" bpmnElement="Sales"><bpmndi:BPMNShape id="Sales_Lane0_di" bpmnElement="Sales_Lane0" isHorizontal="false"><dc:Bounds x="70" y="60" width="320" height="2280"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sales_Lane1_di" bpmnElement="Sales_Lane1" isHorizontal="false"><dc:Bounds x="390" y="60" width="320" height="2280"/></bpmndi:BPMNShape><bpmndi:BPMNEdge id="Sales_F0_di" bpmnElement="Sales_F0"><di:waypoint x="225" y="138"/><di:waypoint x="225" y="176.5"/><di:waypoint x="225" y="176.5"/><di:waypoint x="225" y="215"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Sales_F1_di" bpmnElement="Sales_F1"><di:waypoint x="225" y="287"/><di:waypoint x="225" y="308.5"/><di:waypoint x="545" y="308.5"/><di:waypoint x="545" y="330"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Sales_F2_di" bpmnElement="Sales_F2"><di:waypoint x="545" y="402"/><di:waypoint x="545" y="423.5"/><di:waypoint x="545" y="423.5"/><di:waypoint x="545" y="445"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Sales_F3_di" bpmnElement="Sales_F3"><di:waypoint x="545" y="501"/><di:waypoin